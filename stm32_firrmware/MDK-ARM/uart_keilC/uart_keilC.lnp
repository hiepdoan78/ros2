--cpu Cortex-M3
"uart_keilc\startup_stm32f103xb.o"
"uart_keilc\main.o"
"uart_keilc\stm32f1xx_it.o"
"uart_keilc\stm32f1xx_hal_msp.o"
"uart_keilc\stm32f1xx_hal_gpio_ex.o"
"uart_keilc\stm32f1xx_hal_tim.o"
"uart_keilc\stm32f1xx_hal_tim_ex.o"
"uart_keilc\stm32f1xx_hal.o"
"uart_keilc\stm32f1xx_hal_rcc.o"
"uart_keilc\stm32f1xx_hal_rcc_ex.o"
"uart_keilc\stm32f1xx_hal_gpio.o"
"uart_keilc\stm32f1xx_hal_dma.o"
"uart_keilc\stm32f1xx_hal_cortex.o"
"uart_keilc\stm32f1xx_hal_pwr.o"
"uart_keilc\stm32f1xx_hal_flash.o"
"uart_keilc\stm32f1xx_hal_flash_ex.o"
"uart_keilc\stm32f1xx_hal_exti.o"
"uart_keilc\stm32f1xx_hal_uart.o"
"uart_keilc\system_stm32f1xx.o"
--strict --scatter "uart_keilC\uart_keilC.sct"
--summary_stderr --info summarysizes --map --load_addr_map_info --xref --callgraph --symbols
--info sizes --info totals --info unused --info veneers
--list "uart_keilC.map" -o uart_keilC\uart_keilC.axf